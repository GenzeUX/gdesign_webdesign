NEXT_PUBLIC_SITE_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Required on multi-instance deployments. Durable shared rate limiting via Redis REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set true only behind a proxy that overwrites x-forwarded-for.
TRUST_PROXY=false
# Default is a local brief that the visitor sends in their personal Telegram chat.
CONTACT_DELIVERY=telegram
# Enable after activating Web Analytics in the Vercel project. Preview is excluded.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Custom Vercel events require an eligible plan; leave false on Hobby.
NEXT_PUBLIC_ANALYTICS_CUSTOM_EVENTS=false
